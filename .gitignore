# Strategy detail and session records — not for the public repo
.claude/private/
.claude/settings.local.json

# Local environment
.env
*.config.yml
!*.config.sample.yml
.venv/
__pycache__/
*.pyc
.DS_Store

# Internal tooling that describes the neighbouring private pipeline (containers, ports,
# database and table names). Useless to anyone cloning this repo, and it stands on its own.
.claude/skills/orient/

# Scheduler output and the cycle lock — runtime state, not results.
# data/nbbo/ and data/equity_curve.csv are deliberately NOT ignored: they are the
# accruing evidence, and the NBBO captures cannot be reconstructed.
logs/
.cycle.lock

# Ruff writes a self-ignoring .gitignore inside its own cache, so this is belt-and-braces --
# but it means the repo does not depend on a tool continuing to clean up after itself.
.ruff_cache/

# UI build output and dependencies
ui/node_modules/
ui/.next/
ui/next-env.d.ts

# Scheduled-job stderr kept as evidence, but it is machine-local noise in a public repo.
logs/archive/

# markwatch runtime state -- the journal is per-run, not source
journal.db
journal.db-*
markwatch/preflight.db*
